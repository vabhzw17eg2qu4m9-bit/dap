{
  "name": "mcp-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Universal MCP stdio bridge for the Distributed Agents Platform (DAP/1): one outbound WSS to the hub, seven dap_* tools",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "ws": "8.18.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "22.19.10",
    "@types/ws": "8.18.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
